<?xml version="1.0" encoding="utf-8"?>
<!--
  The SmartCrop ML backend is a local Flask server reached over plain HTTP on a
  private network (e.g. http://192.168.18.84:5000). Android blocks cleartext
  traffic by default from API 28, so it must be re-enabled for private LAN
  addresses only - public/internet traffic still requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- RFC 1918 private ranges. Android matches the literal host, so
             enumerate the backend host you actually use (see
             CropApiService.baseUrl in lib/services/crop_api_service.dart). -->
        <domain includeSubdomains="false">192.168.18.84</domain>
    </domain-config>
</network-security-config>
